AUTO_PUBLISH=true
LLM_ENABLED=true
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Browser configuration is consumed only by the isolated deployment artifact,
# not a normal Python build or a static server of tracked site/.
# The bounded Gemini extractor runs when GEMINI_API_KEY is available. Set
# LLM_ENABLED=false to skip new article interpretation without changing lifecycle checks.
FOOD_LLM_API_KEY=
FOOD_LLM_BASE_URL=
FOOD_LLM_MODEL=
FOOD_LLM_PROVIDER=
